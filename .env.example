# ==============================================================================
# Database Configuration (Neon PostgreSQL & Drizzle ORM)
# ==============================================================================
# Connection string from your Neon dashboard (e.g. postgresql://user:password@ep-xyz.region.aws.neon.tech/dbname?sslmode=require)
DATABASE_URL=postgresql://user:password@endpoint.region.aws.neon.tech/neondb?sslmode=require

# ==============================================================================
# Upstash QStash Configuration
# ==============================================================================
# Yes, you can use the same QStash token and signing keys across multiple projects!
# Found in your Upstash Console under QStash -> Details / Keys
QSTASH_TOKEN=ey...
QSTASH_CURRENT_SIGNING_KEY=sig_...
QSTASH_NEXT_SIGNING_KEY=sig_...

# ==============================================================================
# Twilio Configuration
# ==============================================================================
# Found in your Twilio Console dashboard
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...

# ==============================================================================
# Server & Public Domain Settings
# ==============================================================================
PORT=3000
HOST=0.0.0.0

# Base URL used to build tracking links, opt-out links, and QStash webhook callbacks.
# For local dev with QStash webhooks, use your ngrok or cloudflare tunnel URL (e.g. https://abc123xyz.ngrok-free.app)
BASE_URL=http://localhost:3000
