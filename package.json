    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@fastify/env": "^7.0.1",
    "@neondatabase/serverless": "^1.2.1",
    "@upstash/qstash": "^2.12.2",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "twilio": "^6.3.0"
  }
