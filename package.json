{
  "name": "review-requester",
  "version": "1.0.0",
  "type": "module",
  "description": "Multi-tenant Review Requester microservice",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --experimental-strip-types src/server.ts",
    "test": "node --experimental-strip-types --test test/**/*.test.ts",
